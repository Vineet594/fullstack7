# Copy to .env (never commit .env). Export these as environment variables (or set them in IntelliJ/VS Code run config).
# ---- Database (MySQL locally) ----
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=securecms
DB_USERNAME=securecms
DB_PASSWORD=change-me-local
DB_PARAMS=?allowPublicKeyRetrieval=true&useSSL=false

# ---- Secrets: generate your own, at least 32 characters ----
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
AES_SECRET_KEY=replace-with-another-long-random-string-min-32

# ---- Optional ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SEED_SAMPLE_DATA=true
SEED_DEMO_PASSWORD=Demo@12345
SHOW_SQL=false
