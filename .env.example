# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
DB_URL=jdbc:mysql://localhost:3306/secure_cms?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change_me_mysql_password

# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars

# Base64 encoded 32-byte (AES-256) key. Generate one with:  openssl rand -base64 32
AES_SECRET_KEY=change_me_base64_32_byte_key

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
SEED_ENABLED=true
SHOW_SQL=false
